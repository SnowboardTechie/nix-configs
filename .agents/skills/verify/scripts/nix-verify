#!/usr/bin/env python3
"""nix-verify: prove this flake's outputs evaluate, build and pass their checks, without activating anything.

Usage (from the repository root):
  nix-verify doctor
  nix-verify journeys
  nix-verify run [journey ...] [-- test-name ...]   no journey: the default set
  nix-verify cleanup [run directory]          no directory: only runs whose process is gone

Every nix call this command makes passes --no-update-lock-file, and builds pass --no-link.
The repository's own tests (module-tests) run their own Nix calls, unlocked, so they run in a
throwaway copy of the worktree: the real flake.lock and tree cannot be written by them.
Nothing here runs switch, activate, update-system, upgrade-system or `nix flake update`.
"""
import datetime
import fcntl
import hashlib
import json
import os
import shutil
import signal
import subprocess
import sys
import tempfile
import time
from pathlib import Path

REPO = Path(__file__).resolve().parents[4]
EVIDENCE = Path(os.environ.get("NIX_VERIFY_EVIDENCE") or Path(os.environ.get("TMPDIR", "/tmp")) / "nix-verify").resolve()
NIX = ["nix", "--extra-experimental-features", "nix-command flakes"]
LOCKED = ["--no-update-lock-file"]
FLAKE = "."

JOURNEYS = {
    "evaluate": ("default", "Every darwinConfigurations and nixosConfigurations host evaluates to a system derivation (~45 s)"),
    "build-darwin": ("default", "Every darwin host's system builds (--no-link) and holds an activate script; never run (~40 s cached)"),
    "flake-check": ("default", "nix flake check for this machine's system (~20 s)"),
    "module-tests": ("opt-in", "Every scripts/test_*.py, or the ones named after --, in a throwaway copy; ~12 min for all"),
}
# The number of scripts/test_*.py that features/module-tests.md states. Change both together.
EXPECTED_TESTS = 19
SCRATCH_PREFIX = "nix-verify-tests-"
SCRATCH_MARKER = "nix-verify-run.json"
DEFAULT = [name for name, (kind, _) in JOURNEYS.items() if kind == "default"]


class Failed(Exception):
    pass


class Run:
    def __init__(self, journey):
        stamp = datetime.datetime.now(datetime.timezone.utc).strftime("%Y%m%dT%H%M%SZ")
        self.dir = EVIDENCE / f"{stamp}-{journey}"
        n = 1
        while self.dir.exists():
            n += 1
            self.dir = EVIDENCE / f"{stamp}-{journey}-{n}"
        self.dir.mkdir(parents=True)
        self.journey = journey
        self.steps = []
        self.child = None
        # Held for the life of this process: cleanup reads "lock free" as "this run's process is gone",
        # and signals only the process that holds this file, has the recorded PID and the recorded start time.
        self.lock = open(self.dir / "run.lock", "w")
        fcntl.flock(self.lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        self.meta = {"journey": journey, "pid": os.getpid(), "process_start": process_start(os.getpid()),
                     "flake_lock": lock_vs_head(),
                     "run_dir": str(self.dir), "repo": str(REPO), "status": "running",
                     "commit": git("rev-parse", "HEAD").strip(), "started": stamp}
        self.save_meta()

    def save_meta(self):
        (self.dir / "run.json").write_text(json.dumps(self.meta, indent=2) + "\n")

    def log(self, text):
        print(text, flush=True)
        with open(self.dir / "log.txt", "a") as f:
            f.write(text + "\n")

    def sh(self, name, argv, timeout=1800, env=None, cwd=None):
        """Run argv from the repository root (or cwd); return (exit code, stdout, stderr). The command goes to commands.jsonl."""
        start = time.monotonic()
        self.child = subprocess.Popen(argv, cwd=cwd or REPO, text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                                      env={**os.environ, **(env or {})})
        try:
            out, err = self.child.communicate(timeout=timeout)
        except subprocess.TimeoutExpired:
            self.child.kill()
            out, err = self.child.communicate()
            err += f"\nnix-verify: killed after {timeout} s"
        code, self.child = self.child.returncode, None
        seconds = round(time.monotonic() - start, 1)
        safe = name.replace("/", "_").replace(" ", "_")
        (self.dir / f"{len(self.steps) + 1:02d}-{safe}.out").write_text(out)
        (self.dir / f"{len(self.steps) + 1:02d}-{safe}.err").write_text(err)
        with open(self.dir / "commands.jsonl", "a") as f:
            f.write(json.dumps({"step": name, "argv": argv, "cwd": str(cwd or REPO), "exit": code, "seconds": seconds}) + "\n")
        return code, out, err, seconds

    def step(self, name, fn):
        start = time.monotonic()
        try:
            detail = fn()
        except Failed as e:
            seconds = round(time.monotonic() - start, 1)
            self.steps.append({"step": name, "ok": False, "seconds": seconds, "error": str(e)})
            self.log(f"step {name}: FAIL ({seconds} s)\n  {str(e)[-1500:].replace(chr(10), chr(10) + '  ')}")
            return False
        seconds = round(time.monotonic() - start, 1)
        self.steps.append({"step": name, "ok": True, "seconds": seconds, "detail": detail})
        self.log(f"step {name}: ok ({seconds} s){' ' + detail if detail else ''}")
        return True

    def finish(self):
        ok = all(s["ok"] for s in self.steps)
        (self.dir / "result.json").write_text(json.dumps({"journey": self.journey, "passed": ok, "steps": self.steps}, indent=2) + "\n")
        self.meta.update(status="passed" if ok else "failed", cleaned=True)
        self.save_meta()
        self.log(f"{self.journey}: {'PASSED' if ok else 'FAILED'}  evidence {self.dir}")
        return ok


def git(*args):
    return subprocess.run(["git", *args], cwd=REPO, text=True, capture_output=True, check=True).stdout


def process_start(pid):
    """The process's start time as ps reports it, or None when there is no such process."""
    out = subprocess.run(["ps", "-o", "lstart=", "-p", str(pid)], text=True, capture_output=True).stdout.strip()
    return out or None


def tree_state(root=REPO):
    """Every file under root, ignored ones included, except git's own metadata directory: path -> mode and SHA-256.
    A symlink is recorded by its target. In a linked worktree `.git` is a file and is included."""
    state = {}
    for dirpath, dirnames, filenames in os.walk(root):
        if Path(dirpath) == Path(root) and ".git" in dirnames:
            dirnames.remove(".git")
        for name in filenames + [d for d in dirnames if os.path.islink(os.path.join(dirpath, d))]:
            path = os.path.join(dirpath, name)
            rel = os.path.relpath(path, root)
            st = os.lstat(path)
            if os.path.islink(path):
                state[rel] = f"link {os.readlink(path)}"
            else:
                with open(path, "rb") as f:
                    state[rel] = f"{st.st_mode:o} {hashlib.file_digest(f, 'sha256').hexdigest()}"
    return state


def tree_diff(before, after):
    return ([f"+ {p}" for p in sorted(after.keys() - before.keys())] +
            [f"- {p}" for p in sorted(before.keys() - after.keys())] +
            [f"~ {p}" for p in sorted(before.keys() & after.keys()) if before[p] != after[p]])


def lock_vs_head():
    return "matches HEAD" if subprocess.run(["git", "diff", "--quiet", "HEAD", "--", "flake.lock"], cwd=REPO).returncode == 0 \
        else "differs from HEAD (an edited lock is being verified, as it is on disk)"


def nix_ok(run, name, argv, timeout=1800):
    code, out, err, seconds = run.sh(name, argv, timeout)
    if code != 0:
        tail = "\n".join(l for l in err.splitlines() if l.strip())[-1500:]
        raise Failed(f"exit {code} after {seconds} s: {tail}")
    return out


def host_names(run, kind):
    out = nix_ok(run, f"list {kind}", [*NIX, "eval", *LOCKED, "--json", f"{FLAKE}#{kind}", "--apply", "builtins.attrNames"])
    names = json.loads(out)
    if not names:
        raise Failed(f"{kind} is empty")
    return names


def toplevel(kind, host):
    return (f"{FLAKE}#darwinConfigurations.{host}.system" if kind == "darwinConfigurations"
            else f"{FLAKE}#nixosConfigurations.{host}.config.system.build.toplevel")


def j_evaluate(run):
    found = {}
    for kind in ("darwinConfigurations", "nixosConfigurations"):
        hosts = []
        if not run.step(f"list {kind}", lambda: hosts.extend(host_names(run, kind)) or ", ".join(hosts)):
            continue
        found.update(dict.fromkeys(hosts, kind))
        for host in hosts:
            def check(host=host, kind=kind):
                drv = nix_ok(run, f"eval {host}", [*NIX, "eval", *LOCKED, "--raw", toplevel(kind, host) + ".drvPath"]).strip()
                if not (drv.startswith("/nix/store/") and drv.endswith(".drv") and Path(drv).exists()):
                    raise Failed(f"no system derivation: {drv!r}")
                return drv
            run.step(f"evaluate {host}", check)

    def every_host_module_is_a_configuration():
        expected = sorted(p.stem for p in (REPO / "modules" / "hosts").glob("*.nix") if not p.stem.startswith("_"))
        missing = [h for h in expected if h not in found]
        if missing:
            raise Failed(f"modules/hosts/ has {', '.join(missing)} but the flake exports no configuration for it")
        return ", ".join(f"{h} ({found[h]})" for h in expected)
    run.step("every modules/hosts/*.nix is a configuration", every_host_module_is_a_configuration)


def j_build_darwin(run):
    hosts = []
    if not run.step("list darwinConfigurations", lambda: hosts.extend(host_names(run, "darwinConfigurations")) or ", ".join(hosts)):
        return
    for host in hosts:
        def check(host=host):
            out = nix_ok(run, f"build {host}", [*NIX, "build", *LOCKED, "--no-link", "--print-out-paths",
                                                toplevel("darwinConfigurations", host)], timeout=3600).strip()
            missing = [p for p in ("activate", "sw/bin", "darwin-version.json") if not (Path(out) / p).exists()]
            if missing:
                raise Failed(f"{out} lacks {', '.join(missing)}")
            return out
        run.step(f"build {host}", check)


def j_flake_check(run):
    run.step("nix flake check", lambda: (nix_ok(run, "flake-check", [*NIX, "flake", "check", *LOCKED]), "")[1])


def throwaway_copy(run):
    """Copy the worktree's files (tracked, and untracked but not ignored) to a fresh directory outside it.
    The repository's tests find the flake from their own path (scripts/..), so in the copy every Nix call they
    make, locked or not, and every file they write land in the copy."""
    scratch = Path(tempfile.mkdtemp(prefix=SCRATCH_PREFIX))
    (scratch / SCRATCH_MARKER).write_text(json.dumps({"run_dir": str(run.dir), "pid": os.getpid()}) + "\n")
    run.meta["scratch"] = str(scratch)
    run.save_meta()
    files = git("ls-files", "-z", "--cached", "--others", "--exclude-standard").split("\0")
    for rel in filter(None, files):
        src = REPO / rel
        if not src.exists() and not src.is_symlink():
            continue  # deleted in the worktree but not yet staged
        dst = scratch / "repo" / rel
        dst.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(src, dst, follow_symlinks=False)
    return scratch / "repo"


def remove_scratch(path, run_dir):
    """Remove the throwaway copy that run_dir's run made, and nothing else. The path must not be a symlink, must be
    a direct child of the temporary directory with the generated prefix, and must hold the marker that run wrote
    naming run_dir. Returns None when removed, or the reason it refused (and removed nothing)."""
    given = Path(path)
    if given.is_symlink():
        return f"{path} is a symlink"
    p = given.resolve()
    if p.parent != Path(tempfile.gettempdir()).resolve() or not p.name.startswith(SCRATCH_PREFIX):
        return f"{p} is not a {SCRATCH_PREFIX}* directory directly in {tempfile.gettempdir()}"
    if not p.exists():
        return None
    marker = p / SCRATCH_MARKER
    try:
        if marker.is_symlink():
            raise ValueError("a symlink")
        named = json.loads(marker.read_text()).get("run_dir")
    except (OSError, ValueError) as e:
        return f"{p} has no readable {SCRATCH_MARKER} ({e})"
    if not named or Path(named).resolve() != Path(run_dir).resolve():
        return f"{p}'s {SCRATCH_MARKER} names {named}, not {run_dir}"
    shutil.rmtree(p, ignore_errors=True)
    return None


def j_module_tests(run, names):
    tests = sorted((REPO / "scripts").glob("test_*.py"))
    if names:
        wanted = {n.removeprefix("test_").removesuffix(".py") for n in names}
        unknown = wanted - {t.stem.removeprefix("test_") for t in tests}
        if unknown:
            raise SystemExit(f"nix-verify: no scripts/test_<name>.py for {', '.join(sorted(unknown))}")
        tests = [t for t in tests if t.stem.removeprefix("test_") in wanted]

    def the_set():
        if not tests:
            raise Failed("no scripts/test_*.py found: nothing would be verified")
        if not names and len(tests) != EXPECTED_TESTS:
            raise Failed(f"found {len(tests)} scripts/test_*.py, features/module-tests.md states {EXPECTED_TESTS}: "
                         "update EXPECTED_TESTS and the feature file together")
        return f"{len(tests)} test(s)"
    if not run.step("test set", the_set):
        return

    copy = []
    if not run.step("throwaway copy", lambda: copy.append(throwaway_copy(run)) or str(copy[0])):
        return
    copy = copy[0]
    lock_before = tree_state(copy).get("flake.lock")
    for test in tests:
        def check(test=test):
            code, out, err, seconds = run.sh(test.stem, [sys.executable, str(test.relative_to(REPO))], timeout=3600,
                                             env={"PYTHONDONTWRITEBYTECODE": "1"}, cwd=copy)
            summary = (err.strip().splitlines() or ["(no output)"])[-1]
            if code != 0:
                fails = [l for l in err.splitlines() if l.startswith(("FAIL:", "ERROR:"))]
                raise Failed(f"exit {code} after {seconds} s, {summary}\n" + "\n".join(fails))
            return summary
        run.step(test.stem, check)

    def copy_lock_unchanged():
        if tree_state(copy).get("flake.lock") != lock_before:
            raise Failed("a test changed flake.lock in the throwaway copy; the real one was not written")
        return "the copy's flake.lock is unchanged too"
    run.step("tests left flake.lock alone", copy_lock_unchanged)
    refused = remove_scratch(copy.parent, run.dir)
    if refused:
        run.log(f"throwaway copy kept: {refused}")


def run_journey(name, test_names):
    run = Run(name)
    run.log(f"run {name}: {run.dir}\nrepo {REPO} at {run.meta['commit']}\nflake.lock {lock_vs_head()}")
    before = tree_state()
    (run.dir / "tree-before.txt").write_text(json.dumps(before, indent=2, sort_keys=True))

    def on_term(signum, frame):
        if run.child and run.child.poll() is None:
            run.child.terminate()
        if run.meta.get("scratch"):
            remove_scratch(run.meta["scratch"], run.dir)
        run.log(f"signal {signum}: stopping")
        run.steps.append({"step": "interrupted", "ok": False, "seconds": 0, "error": f"signal {signum}"})
        run.finish()
        sys.exit(1)
    signal.signal(signal.SIGTERM, on_term)
    signal.signal(signal.SIGINT, on_term)

    if name == "evaluate":
        j_evaluate(run)
    elif name == "build-darwin":
        j_build_darwin(run)
    elif name == "flake-check":
        j_flake_check(run)
    elif name == "module-tests":
        j_module_tests(run, test_names)

    def untouched():
        after = tree_state()
        (run.dir / "tree-after.txt").write_text(json.dumps(after, indent=2, sort_keys=True))
        diff = tree_diff(before, after)
        if diff:
            raise Failed("the worktree changed during the run:\n" + "\n".join(diff))
        return f"all {len(after)} files unchanged, flake.lock and ignored files included"
    run.step("worktree untouched", untouched)
    return run.finish()


def doctor():
    bad = 0

    def report(level, name, text):
        nonlocal bad
        bad += level == "FAIL"
        print(f"{level:4} {name}: {text}")

    nix = shutil.which("nix")
    if not nix:
        report("FAIL", "nix", "not on PATH")
    else:
        v = subprocess.run(["nix", "--version"], text=True, capture_output=True).stdout.strip()
        report("ok", "nix", f"{v} ({nix})")
        system = subprocess.run([*NIX, "eval", "--impure", "--raw", "--expr", "builtins.currentSystem"],
                                text=True, capture_output=True).stdout.strip()
        report("ok" if system == "aarch64-darwin" else "WARN", "system",
               system + ("" if system == "aarch64-darwin" else ": build-darwin needs aarch64-darwin"))
        builders = subprocess.run([*NIX, "config", "show", "builders"], text=True, capture_output=True).stdout.strip()
        machines = Path("/etc/nix/machines")
        linux = "x86_64-linux" in builders or (machines.exists() and "x86_64-linux" in machines.read_text())
        report("ok" if linux else "info", "linux builder",
               "configured" if linux else "none: gnarbox (x86_64-linux) is evaluated, never built")
    report("ok" if (REPO / "flake.nix").exists() else "FAIL", "repo", str(REPO))
    lock = lock_vs_head()
    report("ok" if lock == "matches HEAD" else "WARN", "flake.lock", lock)
    untracked = [l[3:] for l in git("status", "--porcelain=v1", "-uall").splitlines()
                 if l.startswith("??") and l.endswith(".nix")]
    report("WARN" if untracked else "ok", "untracked .nix",
           ("invisible to the git flake until `git add`: " + ", ".join(untracked)) if untracked else "none")
    links = [p.name for p in REPO.glob("result*") if p.is_symlink()]
    report("WARN" if links else "ok", "result links", ", ".join(links) or "none")
    report("ok" if shutil.which("python3") else "WARN", "python3", shutil.which("python3") or "missing: module-tests cannot run")
    EVIDENCE.mkdir(parents=True, exist_ok=True)
    report("ok" if os.access(EVIDENCE, os.W_OK) else "FAIL", "evidence", str(EVIDENCE))
    running = []
    for meta in EVIDENCE.glob("*/run.json"):
        m = json.loads(meta.read_text())
        if m.get("status") == "running":
            alive = lock_held(meta.parent)
            running.append(f"{meta.parent.name} ({'in progress' if alive else 'abandoned: run cleanup'})")
            bad += not alive
    report("FAIL" if bad and running else ("info" if running else "ok"), "runs", ", ".join(running) or "none open")
    return 1 if bad else 0


def lock_held(run_dir):
    """True while some process holds the run's run.lock. A run without one is not held."""
    try:
        with open(run_dir / "run.lock", "a") as f:
            try:
                fcntl.flock(f, fcntl.LOCK_EX | fcntl.LOCK_NB)
            except BlockingIOError:
                return True
            fcntl.flock(f, fcntl.LOCK_UN)
            return False
    except FileNotFoundError:
        return False


def holds(pid, path):
    """True when process pid has path open, by lsof."""
    out = subprocess.run(["lsof", "-a", "-p", str(pid), "-Fn"], text=True, capture_output=True).stdout
    want = os.path.realpath(path)
    return any(l[1:] and os.path.realpath(l[1:]) == want for l in out.splitlines() if l.startswith("n"))


def the_runs_process(run_dir, m):
    """The PID to signal for this run, or None with the reason: the recorded PID must be alive, started when
    recorded, and hold this run directory's run.lock."""
    pid = m.get("pid")
    if not isinstance(pid, int) or not m.get("process_start"):
        return None, "run.json records no PID and start time"
    if process_start(pid) != m["process_start"]:
        return None, f"process {pid} is not the one that started the run (start time differs or it is gone)"
    if not holds(pid, run_dir / "run.lock"):
        return None, f"process {pid} does not hold {run_dir / 'run.lock'}"
    return pid, None


def cleanup(target):
    if target:
        run_dir = Path(target).resolve()
        try:
            run_dir.relative_to(EVIDENCE)
        except ValueError:
            print(f"nix-verify: refusing {run_dir}: not under the evidence root {EVIDENCE}", file=sys.stderr)
            return 2
        try:
            run_dir.relative_to(REPO)
            print(f"nix-verify: refusing {run_dir}: inside the repository", file=sys.stderr)
            return 2
        except ValueError:
            pass
        metas = [run_dir / "run.json"]
    else:
        metas = sorted(EVIDENCE.glob("*/run.json"))
    code = 0
    for meta in metas:
        run_dir = meta.parent
        if not meta.exists():
            print(f"no run at {run_dir}")
            code = 1
            continue
        m = json.loads(meta.read_text())
        if m.get("status") != "running":
            continue
        if m.get("run_dir") and Path(m["run_dir"]).resolve() != run_dir.resolve():
            print(f"{run_dir.name}: run.json names another run directory ({m['run_dir']}); left alone")
            code = 1
            continue
        if lock_held(run_dir):
            if not target:
                print(f"{run_dir.name}: in progress; name its directory to stop it")
                continue
            pid, why = the_runs_process(run_dir, m)
            if pid is None:
                print(f"{run_dir.name}: not signalled: {why}")
                code = 1
                continue
            os.kill(pid, signal.SIGTERM)
            print(f"{run_dir.name}: sent SIGTERM to its nix-verify process {pid}")
        if m.get("scratch"):
            refused = remove_scratch(m["scratch"], run_dir)
            if refused:
                print(f"{run_dir.name}: throwaway copy not removed: {refused}")
                code = 1
        m.update(status="abandoned", cleaned=True)
        meta.write_text(json.dumps(m, indent=2) + "\n")
        print(f"{run_dir.name}: marked abandoned; evidence kept")
    return code


def evidence_inside_repo():
    try:
        EVIDENCE.relative_to(REPO)
        return True
    except ValueError:
        return False


def main(argv):
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__)
        return 0 if argv else 2
    cmd, rest = argv[0], argv[1:]
    if cmd in ("doctor", "cleanup", "run") and evidence_inside_repo():
        print(f"nix-verify: refusing {cmd}: the evidence root {EVIDENCE} is inside the repository {REPO}; "
              "set NIX_VERIFY_EVIDENCE outside it", file=sys.stderr)
        return 2
    if cmd == "doctor":
        return doctor()
    if cmd == "journeys":
        for name, (kind, text) in JOURNEYS.items():
            print(f"{name:25} {kind:8} {text}")
        return 0
    if cmd == "cleanup":
        return cleanup(rest[0] if rest else None)
    if cmd == "run":
        names, tests = (rest[:rest.index("--")], rest[rest.index("--") + 1:]) if "--" in rest else (rest, [])
        names = names or DEFAULT
        unknown = [n for n in names if n not in JOURNEYS]
        if unknown:
            print(f"nix-verify: unknown journey {', '.join(unknown)}; see `nix-verify journeys`", file=sys.stderr)
            return 2
        results = [run_journey(n, tests) for n in names]
        if len(names) > 1:
            print("summary: " + ", ".join(f"{n} {'PASSED' if ok else 'FAILED'}" for n, ok in zip(names, results)))
        return 0 if all(results) else 1
    print(f"nix-verify: unknown command {cmd}", file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
