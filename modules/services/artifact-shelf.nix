# Artifact Shelf: one permanent page for the visual artifacts Hermes prepares
# (briefing pages, prototypes, screenshot sets, galleries), with a stable URL
# per artifact.
#
# Root (default ~/Library/Application Support/Artifact Shelf):
#   items/<slug>/      served: a copied directory, or a symlink with --link
#   items/index.html   the shelf page, regenerated by `artifact-shelf index`
#   meta/<slug>.json   one record per item (not served)
#   retired/           retired items and records (not served)
#
# Publish:  artifact-shelf publish DIR --slug NAME --title T --project P --description D [--link]
# Retire:   artifact-shelf retire SLUG
#
# Caddy serves items/ on loopback; with tailscaleHttpsPort, Tailscale Serve
# publishes it tailnet-only over HTTPS (never Funnel). The index agent
# rebuilds the page when items/ or meta/ change and every
# refreshIntervalSeconds, which catches linked sources that vanish and items
# aging into the Older section. Each rebuild re-walks linked items and leaves
# off any that gained a symlink leaving the item (status `unsafe` in
# `artifact-shelf list`); Caddy would still serve such a path if asked for it
# directly, so `publish` refuses those links up front as well.
{ inputs, ... }:
{
  flake.modules.darwin.artifact-shelf =
    { config
    , lib
    , pkgs
    , ...
    }:
    let
      cfg = config.services.artifact-shelf;
      loopback = cfg.host == "127.0.0.1" || cfg.host == "::1";
      listen = if cfg.host == "::1" then "[::1]:${toString cfg.port}" else "${cfg.host}:${toString cfg.port}";

      script = pkgs.writeText "artifact-shelf.py" (builtins.readFile ./artifact-shelf.py);

      # Environment variables already set win, so tests and one-off runs can
      # point the CLI at another root.
      cli = pkgs.writeShellScriptBin "artifact-shelf" ''
        if [ -z "''${ARTIFACT_SHELF_ROOT:-}" ]; then ARTIFACT_SHELF_ROOT=${lib.escapeShellArg cfg.root}; fi
        if [ -z "''${ARTIFACT_SHELF_URL:-}" ]; then ARTIFACT_SHELF_URL=${lib.escapeShellArg cfg.baseUrl}; fi
        if [ -z "''${ARTIFACT_SHELF_OLDER_DAYS:-}" ]; then ARTIFACT_SHELF_OLDER_DAYS=${toString cfg.olderAfterDays}; fi
        export ARTIFACT_SHELF_ROOT ARTIFACT_SHELF_URL ARTIFACT_SHELF_OLDER_DAYS
        exec ${pkgs.python3Minimal}/bin/python3 ${script} "$@"
      '';

      # Every response, 404s included. No CSP: artifacts carry inline scripts
      # and styles. no-cache so a revised artifact shows on reload.
      headers = {
        handler = "headers";
        response.set = {
          "X-Robots-Tag" = [ "noindex, nofollow, noarchive" ];
          "X-Content-Type-Options" = [ "nosniff" ];
          "Referrer-Policy" = [ "no-referrer" ];
          "Cache-Control" = [ "no-cache" ];
        };
      };

      caddyConfig = pkgs.writeText "artifact-shelf-caddy.json" (builtins.toJSON {
        admin.disabled = true;
        apps.http.servers.artifact-shelf = {
          listen = [ listen ];
          automatic_https.disable = true;
          routes = [
            { handle = [ headers ]; }
            {
              handle = [{
                handler = "file_server";
                root = "${cfg.root}/items";
                # Staging directories and other dotfiles are never served.
                hide = [ ".*" ];
                # No browse: a directory without index.html is a 404.
                # An unknown path must 404, never fall through.
                pass_thru = false;
              }];
              terminal = true;
            }
            {
              handle = [{
                handler = "static_response";
                status_code = 404;
              }];
              terminal = true;
            }
          ];
        };
      });
    in
    {
      options.services.artifact-shelf = {
        enable = lib.mkEnableOption "Artifact Shelf, a stable home for Hermes's visual artifacts";

        root = lib.mkOption {
          type = lib.types.str;
          default = "/Users/${config.system.primaryUser}/Library/Application Support/Artifact Shelf";
          description = ''
            Shelf root. items/ is served; meta/ and retired/ are not. The CLI
            creates all three as the user when they are missing.
          '';
        };

        host = lib.mkOption {
          type = lib.types.str;
          default = "127.0.0.1";
          description = "Listen address. Loopback only (127.0.0.1 or ::1).";
        };

        port = lib.mkOption {
          type = lib.types.port;
          default = 8092;
          description = "Loopback port Caddy serves the shelf on.";
        };

        tailscaleHttpsPort = lib.mkOption {
          type = lib.types.nullOr lib.types.port;
          default = null;
          example = 8092;
          description = ''
            Tailnet-only HTTPS port that Tailscale Serve forwards to the shelf.
            Requires services.tailscale and a loopback host.
          '';
        };

        baseUrl = lib.mkOption {
          type = lib.types.str;
          default = "http://127.0.0.1:${toString cfg.port}";
          defaultText = lib.literalExpression ''"http://127.0.0.1:''${toString port}"'';
          description = "URL the CLI prints item links under. Hosts publishing over Serve set the tailnet URL.";
        };

        olderAfterDays = lib.mkOption {
          type = lib.types.ints.positive;
          default = 30;
          description = "Items not updated for this many days move into the collapsed Older section.";
        };

        refreshIntervalSeconds = lib.mkOption {
          type = lib.types.ints.positive;
          default = 600;
          description = "How often the index agent rebuilds the page regardless of file changes.";
        };

        package = lib.mkOption {
          type = lib.types.package;
          readOnly = true;
          default = cli;
          description = "The artifact-shelf CLI, with this host's root and URL baked in.";
        };
      };

      config = lib.mkIf cfg.enable {
        assertions = [
          {
            assertion = loopback;
            message = "services.artifact-shelf.host must be loopback (127.0.0.1 or ::1)";
          }
          {
            assertion = cfg.tailscaleHttpsPort == null || (config.services.tailscale.enable && loopback);
            message = "services.artifact-shelf.tailscaleHttpsPort requires services.tailscale and a loopback host";
          }
        ];

        environment.systemPackages = [ cli ];

        launchd.user.agents.artifact-shelf = {
          serviceConfig = {
            ProgramArguments = [
              "${pkgs.caddy}/bin/caddy"
              "run"
              "--config"
              "${caddyConfig}"
            ];
            RunAtLoad = true;
            KeepAlive = true;
            StandardOutPath = "/tmp/artifact-shelf.log";
            StandardErrorPath = "/tmp/artifact-shelf.error.log";
          };
        };

        # One-shot: the CLI creates items/ meta/ retired/ as the user, then
        # rewrites index.html only when its content changed, so its own write
        # doesn't keep retriggering WatchPaths.
        launchd.user.agents.artifact-shelf-index = {
          serviceConfig = {
            ProgramArguments = [ "${cli}/bin/artifact-shelf" "index" ];
            RunAtLoad = true;
            WatchPaths = [ "${cfg.root}/items" "${cfg.root}/meta" ];
            StartInterval = cfg.refreshIntervalSeconds;
            StandardOutPath = "/tmp/artifact-shelf-index.log";
            StandardErrorPath = "/tmp/artifact-shelf-index.error.log";
          };
        };

        # Loopback listener: no firewall registration.
        system.activationScripts.extraActivation.text = lib.mkAfter (lib.optionalString (cfg.tailscaleHttpsPort != null) ''

          # === artifact-shelf: shelf via Tailscale Serve ===
          if ! ${pkgs.coreutils}/bin/timeout --foreground 30s \
            ${config.services.tailscale.package}/bin/tailscale serve \
              --bg \
              --yes \
              --https=${toString cfg.tailscaleHttpsPort} \
              http://${listen}; then
            echo "Failed to configure Tailscale Serve for Artifact Shelf on port ${toString cfg.tailscaleHttpsPort}" >&2
            exit 1
          fi
        '');
      };
    };

  # NixOS stub per repository convention: the shelf is Studio-only for now.
  flake.modules.nixos.artifact-shelf = { };
}
