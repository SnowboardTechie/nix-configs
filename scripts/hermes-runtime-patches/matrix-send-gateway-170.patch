+# --- the verb's boundary and an older gateway --------------------------------------------------
+
+def test_verb_refuses_a_peer_the_socket_did_not_authenticate(home):
+    """Same gate as the gateway's other private verbs: no verified same-user peer, no send."""
+    adapter = FakeAdapter()
+    server = GatewayControlServer(home)
+    server.private_handlers[fwd.VERB] = fwd.matrix_send_verb(FakeRunner(adapter), asyncio.new_event_loop())
+    raw = json.dumps({"protocol": 1, "verb": fwd.VERB, "id": 1,
+                      "params": {"home": str(home), "chat_id": ROOM, "message": "x"}}).encode()
+    response = json.loads(server.handle_request_line(raw, None))
+    assert response["ok"] is False and "authenticated" in response["error"]
+    assert adapter.calls == []
+
+
+def test_gateway_without_the_verb_is_a_refusal_to_restart_it(home):
+    class OldGateway(GatewayHarness):
+        def __enter__(self):
+            def run():
+                asyncio.set_event_loop(self.loop)
+                self.server = GatewayControlServer(self.home)
+                self.loop.run_until_complete(self.server.start())
+                self.ready.set()
+                self.loop.run_forever()
+                self.loop.run_until_complete(self.server.stop())
+
+            self.thread = threading.Thread(target=run, daemon=True)
+            self.thread.start()
+            assert self.ready.wait(5)
+            return self
+
+    with OldGateway(home, FakeAdapter()):
+        result = fwd.forward_matrix_send(home, ROOM, "hello", [], None)
+    assert "restart the gateway" in result["error"] and "second Matrix connection" in result["error"]
