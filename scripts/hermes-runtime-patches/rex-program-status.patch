+_REX_STATES = frozenset({"idle", "working", "done", "blocked", "error"})
+_REX_KINDS = frozenset({"permission", "question", "auth"})
+
+
+def rex_supported(env=None) -> bool:
+    """True inside a Rex terminal, which reads the OSC 7501 Program Status Protocol."""
+    env = os.environ if env is None else env
+    return env.get("TERM_PROGRAM") == "rex"
+
+
+def rex_status(state: str, kind: str = "") -> str:
+    """OSC 7501 report ``state=<state>:app=hermes[:kind=<kind>]``; "" for an unknown state."""
+    if state not in _REX_STATES:
+        return ""
+    fields = [f"state={state}", "app=hermes"]
+    if kind in _REX_KINDS:
+        fields.append(f"kind={kind}")
+    return f"\x1b]7501;{':'.join(fields)}\x1b\\"
+
+
+def rex_report(cli, state: str, kind: str = "") -> None:
+    """Report the CLI session's state to a Rex terminal, once per change; a no-op elsewhere. Written
+    like ``HermesCLI._ring_bell``: behind the renderer when the app runs, else straight to the tty."""
+    if getattr(cli, "_terminal_io_broken", False) or not rex_supported():
+        return
+    seq = rex_status(state, kind)
+    if not seq or getattr(cli, "_rex_status_sent", None) == (state, kind):
+        return
+    cli._rex_status_sent = (state, kind)
+    app = getattr(cli, "_app", None)
+    if app is None or not getattr(app, "_is_running", False):
+        write_tty(seq)
+        return
+    from hermes_cli.cli_terminal_mixin import _run_on_app_loop, _write_terminal_sequence
+
+    def _emit() -> None:
+        try:
+            _write_terminal_sequence(app, seq)
+        except (OSError, ValueError):
+            pass
+
+    _run_on_app_loop(app, _emit)
+
+
+def rex_sync(cli) -> None:
+    """While a turn runs: ``blocked`` with the open prompt's kind, else ``working``."""
+    if getattr(cli, "_approval_state", None):
+        rex_report(cli, "blocked", "permission")
+    elif getattr(cli, "_clarify_state", None):
+        rex_report(cli, "blocked", "question")
+    elif getattr(cli, "_sudo_state", None) or getattr(cli, "_connection_state", None):
+        rex_report(cli, "blocked", "auth")
+    else:
+        rex_report(cli, "working")
+
+
+def rex_turn_end(cli) -> None:
+    """A turn that reported ``working``/``blocked`` ends as ``done``, or ``error`` when it failed."""
+    sent = getattr(cli, "_rex_status_sent", None)
+    if sent and sent[0] in ("working", "blocked"):
+        rex_report(cli, "error" if getattr(cli, "_last_turn_failed", False) else "done")
+
+
 def notification_sequence(context: str, *, prompt: bool, session_id: str = "", detail: str = "") -> str:
     """OSC 9 (plus Warp OSC 777 when supported) for a blocking prompt or turn end."""
     seq = osc9(f"Hermes: {context}")
