+# --- `hermes send --react` / `--redact`: argv as the Pi Durable mirror passes it, JSON on stdout ---
+
+def _hermes_send_argv(*argv):
+    import argparse
+    import io
+    from hermes_cli.send_cmd import register_send_subparser
+    parser = argparse.ArgumentParser(prog="hermes")
+    register_send_subparser(parser.add_subparsers())
+    args = parser.parse_args(["send", *argv])
+    out, err, code = io.StringIO(), io.StringIO(), None
+    with patch("sys.stdout", out), patch("sys.stderr", err), patch("hermes_cli.send_cmd._load_hermes_env"):
+        try:
+            args.func(args)
+        except SystemExit as exc:
+            code = exc.code
+    return code, out.getvalue(), err.getvalue()
+
