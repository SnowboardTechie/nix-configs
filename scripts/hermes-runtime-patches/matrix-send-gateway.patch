+++ b/gateway/matrix_send_forward.py
@@ -0,0 +1,322 @@
+"""Hand ``hermes send`` Matrix messages to the running gateway's live adapter.
+
+A standalone process that connects its own Matrix adapter logs in as the gateway's device and opens the
+gateway's crypto store. The gateway keeps its Olm sessions in memory, so after the other process moves
+that state forward the gateway's next to-device message reuses a message key the recipients already
+used and its room key can never be decrypted. There must be one Matrix sender per device: while a
+gateway owns the home, the message goes to its live adapter over the gateway control socket, and when
+the gateway is there but cannot be reached the send fails instead of opening a second connection.
+With no gateway running, or one that runs no Matrix, the caller keeps its ephemeral standalone connect.
+
+The gateway serving a home is the one whose control socket answers for it: the home's own, else the
+default multiplexer's for a named profile it serves (as ``hermes_cli.gateway_runtime`` discovers it).
+The request names the home, and the gateway sends with that profile's own adapter or answers that it
+does not serve it; the home's ``gateway.lock`` then decides between standalone and a refusal.
+
+``matrix-react`` and ``matrix-redact`` (``hermes send --react`` / ``--redact``) ride the same socket but
+never stand alone: with no gateway sending Matrix for the home they fail, and their caller retries.
+"""
+
+from __future__ import annotations
+
+import asyncio
+import concurrent.futures
+import json
+import logging
+import os
+import re
+import time
+from pathlib import Path
+from typing import Any, Callable, Optional
+
+logger = logging.getLogger(__name__)
+
+VERB = "matrix-send"
+REACT_VERB, REDACT_VERB = "matrix-react", "matrix-redact"
+# Pi Durable (and cron) give a send ~60 s; stay inside that so the caller hears our answer first.
+CLIENT_TIMEOUT = 50.0
+_SERVER_WAIT = 45.0
+_MAX_RESPONSE_BYTES = 512 * 1024
+# The verb's answers that are not a send result: the caller looks further, or stays standalone.
+_UNSERVED, _NO_MATRIX = "unserved", "no_matrix"
+# Matrix room and event IDs as Pi Durable's notifier writes them: the sigil, then printable ASCII with no
+# space, within the spec's 255 bytes. Anything else is refused before it reaches the gateway.
+ROOM_ID = re.compile(r"![!-~]{1,254}")
+EVENT_ID = re.compile(r"\$[!-~]{1,254}")
+# The review ratings: the only reactions these verbs put on a message.
+RATING_REACTIONS = frozenset(("\U0001f44d", "\u2796", "\U0001f44e"))
+_MAX_REASON_CHARS = 256
+
+
+class _Unreachable(Exception):
+    """No control-socket exchange could be started (no/stale/unsafe socket)."""
+
+
+class _NoAnswer(Exception):
+    """The request was sent but no complete answer came back in time."""
+
+
+def missing_owner_state(home: Path) -> str:
+    """``starting`` / ``absent`` / ``inaccessible`` for a home whose control socket did not connect."""
+    from hermes_cli.gateway_runtime_discovery import missing_owner_state as _state
+    return _state(home)
+
+
+def _refusal(why: str, action: str = "send") -> dict:
+    return {"error": (
+        f"Matrix {action} refused: a Hermes gateway owns this home but {why}. Not opening a second Matrix "
+        "connection on the gateway's device: it would desynchronize the gateway's end-to-end encryption "
+        "state. Check `hermes gateway status`, then retry.")}
+
+
+def _request(params: dict, verb: str = VERB) -> bytes:
+    # Unescaped UTF-8: a 15,000-character Matrix chunk of CJK or emoji, \u-escaped, overruns the cap.
+    return json.dumps({"protocol": 1, "verb": verb, "id": 1, "params": params},
+                      ensure_ascii=False).encode("utf-8") + b"\n"
+
+
+def _exchange(home: Path, params: dict, timeout: float, verb: str = VERB) -> dict:
+    """One ``verb`` request over the authenticated control socket; returns the verb's result."""
+    from hermes_cli.gateway_runtime_discovery import DiscoveryError, connect_private
+    deadline = time.monotonic() + timeout
+    try:
+        client = connect_private(home, min(timeout, 2.0))
+    except (OSError, DiscoveryError) as exc:  # includes FileNotFoundError and connection refused
+        raise _Unreachable(str(exc) or type(exc).__name__) from exc
+    request = _request(params, verb)
+    action = verb.removeprefix("matrix-")
+    chunks: list[bytes] = []
+    with client:
+        try:
+            client.settimeout(max(deadline - time.monotonic(), 0.01))
+            client.sendall(request)
+            while b"\n" not in b"".join(chunks[-2:]):
+                remaining = deadline - time.monotonic()
+                if remaining <= 0:
+                    raise _NoAnswer("timed out")
+                client.settimeout(remaining)
+                chunk = client.recv(65536)
+                if not chunk:
+                    break
+                chunks.append(chunk)
+                if sum(map(len, chunks)) > _MAX_RESPONSE_BYTES:
+                    break
+        except TimeoutError as exc:
+            raise _NoAnswer("timed out") from exc
+        except OSError as exc:
+            raise _NoAnswer(str(exc) or type(exc).__name__) from exc
+    try:
+        response = json.loads(b"".join(chunks).partition(b"\n")[0].decode("utf-8"))
+    except ValueError as exc:
+        raise _NoAnswer("sent an unreadable answer") from exc
+    if not isinstance(response, dict):
+        raise _NoAnswer("sent an unreadable answer")
+    if response.get("ok") is not True:
+        error = str(response.get("error") or "")
+        if "unknown verb" in error:
+            return _refusal(f"it predates the {verb} control verb (restart the gateway to pick it up)", action)
+        return {"error": f"Matrix {action} failed in the gateway: {error or 'unknown error'}"}
+    result = response.get("result")
+    return result if isinstance(result, dict) else {"error": f"Matrix {action} failed: gateway sent an invalid result"}
+
+
+def forward_matrix_send(home: Path, chat_id: str, message: str, media_files, thread_id: Optional[str],
+                        *, timeout: float = CLIENT_TIMEOUT) -> Optional[dict]:
+    """Deliver through the gateway serving ``home``. ``None`` means no gateway sends Matrix for it (the
+    caller stays standalone); otherwise the send result dict, which is an error dict when the gateway
+    could not be reached or did not answer."""
+    if os.name == "nt":  # the verb rides the POSIX control socket; the Windows pipe client is not wired
+        return None
+    from gateway.control_socket import _MAX_REQUEST_BYTES
+    from hermes_cli.gateway_runtime import gateway_profile_home
+    from hermes_cli.gateway_runtime_multiplex import multiplexer_root_for
+    home = gateway_profile_home(home)
+    params = {"home": str(home), "chat_id": chat_id, "message": message, "thread_id": thread_id,
+              "media_files": [[str(path), bool(is_voice)] for path, is_voice in (media_files or [])]}
+    if len(_request(params)) > _MAX_REQUEST_BYTES:
+        return {"error": (f"Matrix send: the message is too large to hand to the gateway (over "
+                          f"{_MAX_REQUEST_BYTES} bytes); nothing was sent.")}
+    unreachable = []
+    for control_home in (home, multiplexer_root_for(home)):
+        if control_home is None:
+            continue
+        try:
+            result = _exchange(control_home, params, timeout)
+        except _Unreachable as exc:
+            unreachable.append(str(exc))
+            continue
+        except _NoAnswer as exc:
+            return {"error": (f"Matrix send: the gateway did not answer ({exc}); the message may have been "
+                              "delivered. Not retrying through a second Matrix connection.")}
+        if result.get(_NO_MATRIX) is True:
+            return None
+        if result.get(_UNSERVED) is not True:
+            return result
+    state = missing_owner_state(home)
+    if state == "absent":
+        return None
+    why = "; ".join(unreachable) or "its gateway does not serve this profile"
+    return _refusal(f"its control socket is not reachable ({why}; owner {state})")
+
+
+def matrix_action_params(room_id: str, event_id: str, *, emoji: Optional[str] = None,
+                         reason: Optional[str] = None) -> tuple[str, dict]:
+    """The verb and params of a react (``emoji`` given) or redact; ``ValueError`` names an invalid value."""
+    if not isinstance(room_id, str) or not ROOM_ID.fullmatch(room_id):
+        raise ValueError("not a Matrix room ID")
+    if not isinstance(event_id, str) or not EVENT_ID.fullmatch(event_id):
+        raise ValueError("not a Matrix event ID")
+    if emoji is not None:
+        if emoji not in RATING_REACTIONS:
+            raise ValueError("the reaction must be one of " + " ".join(sorted(RATING_REACTIONS)))
+        return REACT_VERB, {"room_id": room_id, "event_id": event_id, "emoji": emoji}
+    if not isinstance(reason, (str, type(None))) or len(reason or "") > _MAX_REASON_CHARS:
+        raise ValueError(f"the redaction reason must be text of at most {_MAX_REASON_CHARS} characters")
+    return REDACT_VERB, {"room_id": room_id, "event_id": event_id, "reason": reason or ""}
+
+
+def forward_matrix_action(home: Path, verb: str, params: dict, *, timeout: float = CLIENT_TIMEOUT) -> dict:
+    """React or redact through the gateway serving ``home`` (params from ``matrix_action_params``). Always a
+    result dict: there is no standalone path, so no gateway sending Matrix for the home is an error."""
+    action = verb.removeprefix("matrix-")
+    if os.name == "nt":
+        return {"error": f"Matrix {action}: needs the gateway control socket, which this platform lacks"}
+    from hermes_cli.gateway_runtime import gateway_profile_home
+    from hermes_cli.gateway_runtime_multiplex import multiplexer_root_for
+    home = gateway_profile_home(home)
+    params = {"home": str(home), **params}
+    unreachable = []
+    for control_home in (home, multiplexer_root_for(home)):
+        if control_home is None:
+            continue
+        try:
+            result = _exchange(control_home, params, timeout, verb)
+        except _Unreachable as exc:
+            unreachable.append(str(exc))
+            continue
+        except _NoAnswer as exc:
+            return {"error": f"Matrix {action}: the gateway did not answer ({exc}); it may have been applied"}
+        if result.get(_NO_MATRIX) is True:
+            return {"error": f"Matrix {action}: the Hermes gateway serving this home runs no Matrix"}
+        if result.get(_UNSERVED) is not True:
+            return result
+    state = missing_owner_state(home)
+    if state == "absent":
+        return {"error": (f"Matrix {action}: no Hermes gateway is running for this home, and only the gateway "
+                          "sends reactions and redactions. Start it, then retry.")}
+    why = "; ".join(unreachable) or "its gateway does not serve this profile"
+    return _refusal(f"its control socket is not reachable ({why}; owner {state})", action)
+
+
+def _served_profile(runner: Any, home: str) -> Optional[str]:
+    """The profile name this gateway serves ``home`` as, else None."""
+    from gateway.run_runtime import reserved_profile_homes
+    wanted = Path(home).resolve()
+    return next((name for name, served in reserved_profile_homes(runner) if served == wanted), None)
+
+
+def _matrix_pending(runner: Any, profile: str) -> bool:
+    """This gateway runs (or is bringing back) Matrix for ``profile`` though no adapter is live now."""
+    from gateway.config import Platform
+    if profile != (getattr(runner, "_primary_profile_name", None) or "default"):
+        return True  # a served secondary's platform state is not tracked here: never stand alone beside it
+    platform = runner.config.platforms.get(Platform.MATRIX)
+    return bool(getattr(platform, "enabled", False)) or Platform.MATRIX in runner._failed_platforms
+
+
+def matrix_send_verb(runner: Any, loop: asyncio.AbstractEventLoop) -> Callable[[dict, str], dict]:
+    """Private control verb ``matrix-send``: send through this gateway's live Matrix adapter for the
+    profile the request's home is, on the gateway loop the adapter's queues belong to. Runs on the
+    socket executor thread."""
+
+    def _handler(params: dict, peer_subject: str) -> dict:
+        home, chat_id, message = params.get("home"), params.get("chat_id"), params.get("message")
+        thread_id, media = params.get("thread_id"), params.get("media_files", [])
+        if (not isinstance(home, str) or not home or not isinstance(chat_id, str) or not chat_id
+                or not isinstance(message, str)
+                or not (thread_id is None or isinstance(thread_id, str)) or not isinstance(media, list)
+                or not all(isinstance(m, list) and len(m) == 2 and isinstance(m[0], str) for m in media)):
+            return {"error": "Matrix send: invalid parameters"}
+        profile = _served_profile(runner, home)
+        if profile is None:
+            return {_UNSERVED: True}
+        from gateway.config import Platform
+        from tools.send_message_senders import _matrix_send_core
+        adapter = runner._authorization_adapter(Platform.MATRIX, profile)
+        if adapter is None:
+            if not _matrix_pending(runner, profile):
+                return {_NO_MATRIX: True}
+            return {"error": "Matrix send: this gateway's Matrix adapter is not connected right now; retry shortly"}
+        future = asyncio.run_coroutine_threadsafe(
+            _matrix_send_core(adapter, chat_id, message, [(path, bool(voice)) for path, voice in media],
+                              {"thread_id": thread_id} if thread_id else None), loop)
+        try:
+            return future.result(timeout=_SERVER_WAIT)
+        except concurrent.futures.TimeoutError:
+            return {"error": "Matrix send: the gateway's Matrix adapter did not finish in time; "
+                             "the message may have been delivered"}
+        except Exception as exc:  # the caller gets the failure as its send result; the traceback stays here
+            logger.warning("Matrix send for another process failed", exc_info=True)
+            return {"error": f"Matrix send failed: {exc}"}
+
+    return _handler
+
+
+def _matrix_action_verb(runner: Any, loop: asyncio.AbstractEventLoop, verb: str, run) -> Callable[[dict, str], dict]:
+    """A react/redact control verb: validate, find the served profile's live adapter, and await
+    ``run(adapter, params)`` on the gateway loop. Runs on the socket executor thread."""
+    action = verb.removeprefix("matrix-")
+
+    def _handler(params: dict, peer_subject: str) -> dict:
+        home = params.get("home")
+        try:
+            if not isinstance(home, str) or not home:
+                raise ValueError("no home")
+            _, checked = matrix_action_params(params.get("room_id"), params.get("event_id"),
+                                              emoji=(params.get("emoji") or "") if verb == REACT_VERB else None,
+                                              reason=params.get("reason"))
+        except ValueError as exc:
+            return {"error": f"Matrix {action}: invalid parameters ({exc})"}
+        profile = _served_profile(runner, home)
+        if profile is None:
+            return {_UNSERVED: True}
+        from gateway.config import Platform
+        adapter = runner._authorization_adapter(Platform.MATRIX, profile)
+        if adapter is None:
+            if not _matrix_pending(runner, profile):
+                return {_NO_MATRIX: True}
+            return {"error": f"Matrix {action}: this gateway's Matrix adapter is not connected right now; retry shortly"}
+        future = asyncio.run_coroutine_threadsafe(run(adapter, checked), loop)
+        try:
+            return future.result(timeout=_SERVER_WAIT)
+        except concurrent.futures.TimeoutError:
+            return {"error": f"Matrix {action}: the gateway's Matrix adapter did not finish in time; "
+                             "it may have been applied"}
+        except Exception as exc:  # the caller gets the failure as its result; the traceback stays here
+            logger.warning("Matrix %s for another process failed", action, exc_info=True)
+            return {"error": f"Matrix {action} failed: {exc}"}
+
+    return _handler
+
+
+async def _react(adapter: Any, params: dict) -> dict:
+    room_id, event_id, emoji = params["room_id"], params["event_id"], params["emoji"]
+    reaction_id = await adapter._send_reaction(room_id, event_id, emoji)
+    if not reaction_id:
+        return {"error": "Matrix react failed: the homeserver did not accept the reaction"}
+    return {"success": True, "platform": "matrix", "chat_id": room_id, "message_id": str(reaction_id),
+            "reacted_to": event_id, "emoji": emoji}
+
+
+async def _redact(adapter: Any, params: dict) -> dict:
+    room_id, event_id = params["room_id"], params["event_id"]
+    if not await adapter.redact_message(room_id, event_id, params["reason"]):
+        return {"error": "Matrix redact failed: the homeserver did not accept the redaction"}
+    return {"success": True, "platform": "matrix", "chat_id": room_id, "redacted": event_id}
+
+
+def matrix_verbs(runner: Any, loop: asyncio.AbstractEventLoop) -> dict[str, Callable[[dict, str], dict]]:
+    """The gateway's private Matrix control verbs: send, react and redact through its live adapters."""
+    return {VERB: matrix_send_verb(runner, loop),
+            REACT_VERB: _matrix_action_verb(runner, loop, REACT_VERB, _react),
+            REDACT_VERB: _matrix_action_verb(runner, loop, REDACT_VERB, _redact)}
