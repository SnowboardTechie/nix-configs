index 0000000000000000000000000000000000000000..a298db5e550c16577e2b0ea8912c5110c6da69df
--- /dev/null
+++ b/tests/gateway/test_matrix_send_forward.py
@@ -0,0 +1,672 @@
+"""``hermes send`` to Matrix is delivered by the running gateway's live adapter (never a second
+Matrix connection on the gateway's device and crypto store), and refuses when the gateway is up but
+unreachable. With no gateway running the ephemeral standalone connect is unchanged."""
+
+import asyncio
+import json
+import shutil
+import sys
+import tempfile
+import threading
+from pathlib import Path
+from types import SimpleNamespace
+from unittest.mock import AsyncMock, patch
+
+import pytest
+
+from gateway.authz_mixin import GatewayAuthorizationMixin
+from gateway.config import Platform
+from gateway.control_socket import GatewayControlServer
+from gateway import matrix_send_forward as fwd
+from tools.send_message_senders import _send_matrix_via_adapter
+
+pytestmark = pytest.mark.platforms("posix")  # Unix-socket transport
+
+ROOM = "!room:example.com"
+THREAD = "$thread:example.com"
+
+
+class FakeAdapter:
+    def __init__(self, fail=None):
+        self.calls = []
+        self.fail = fail
+
+    async def send(self, chat_id, message, metadata=None):
+        self.calls.append(("send", chat_id, message, metadata))
+        if self.fail:
+            return SimpleNamespace(success=False, error=self.fail, message_id=None)
+        return SimpleNamespace(success=True, message_id="$sent:example.com")
+
+    async def send_image_file(self, chat_id, path, metadata=None):
+        self.calls.append(("send_image_file", chat_id, path, metadata))
+        return SimpleNamespace(success=True, message_id="$img:example.com")
+
+
+@pytest.fixture()
+def home(monkeypatch):
+    # Short path: the stale-socket test binds gateway.sock directly (sun_path limit).
+    d = Path(tempfile.mkdtemp(prefix="hs", dir="/tmp")) / ".hermes"  # no-tmp: ok — AF_UNIX path limit
+    d.mkdir(mode=0o700)
+    d.chmod(0o700)
