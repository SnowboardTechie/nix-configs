diff --git a/tests/gateway/test_matrix_send_forward.py b/tests/gateway/test_matrix_send_forward.py
new file mode 100644
index 0000000000..7538d8e658
--- /dev/null
+++ b/tests/gateway/test_matrix_send_forward.py
@@ -0,0 +1,291 @@
+"""``hermes send`` to Matrix is delivered by the running gateway's live adapter (never a second
+Matrix connection on the gateway's device and crypto store), and refuses when the gateway is up but
+unreachable. With no gateway running the ephemeral standalone connect is unchanged."""
+
+import asyncio
+import json
+import shutil
+import sys
+import tempfile
+import threading
+from pathlib import Path
+from types import SimpleNamespace
+from unittest.mock import AsyncMock, patch
+
+import pytest
+
+from gateway.config import Platform
+from gateway.control_socket import GatewayControlServer
+from gateway import matrix_send_forward as fwd
+from tools.send_message_senders import _send_matrix_via_adapter
+
+pytestmark = pytest.mark.platforms("posix")  # Unix-socket transport
+
+ROOM = "!room:example.com"
+THREAD = "$thread:example.com"
+
+
+class FakeAdapter:
+    def __init__(self, fail=None):
+        self.calls = []
+        self.fail = fail
+
+    async def send(self, chat_id, message, metadata=None):
+        self.calls.append(("send", chat_id, message, metadata))
+        if self.fail:
+            return SimpleNamespace(success=False, error=self.fail, message_id=None)
+        return SimpleNamespace(success=True, message_id="$sent:example.com")
+
+    async def send_image_file(self, chat_id, path, metadata=None):
+        self.calls.append(("send_image_file", chat_id, path, metadata))
+        return SimpleNamespace(success=True, message_id="$img:example.com")
+
+
+@pytest.fixture()
+def home(monkeypatch):
+    # Short path: the stale-socket test binds gateway.sock directly (sun_path limit).
+    d = Path(tempfile.mkdtemp(prefix="hs", dir="/tmp")) / ".hermes"  # no-tmp: ok — AF_UNIX path limit
+    d.mkdir(mode=0o700)
+    d.chmod(0o700)
+    monkeypatch.setenv("HERMES_HOME", str(d))
+    yield d
+    shutil.rmtree(d.parent, ignore_errors=True)
+
+
+class GatewayHarness:
+    """A real control server on a real "gateway" loop thread, with a fake runner holding ``adapter``."""
+
+    def __init__(self, home, adapter):
+        self.home, self.adapter = home, adapter
+        self.loop = asyncio.new_event_loop()
+        self.ready = threading.Event()
+        self.server = None
+        self.runner = SimpleNamespace(adapters={Platform.MATRIX: adapter} if adapter else {})
+
+    def __enter__(self):
+        def run():
+            asyncio.set_event_loop(self.loop)
+            server = GatewayControlServer(self.home)
+            server.private_handlers[fwd.VERB] = fwd.matrix_send_verb(self.runner, self.loop)
+            self.server = server
+            self.loop.run_until_complete(server.start())
+            self.ready.set()
+            self.loop.run_forever()
+            self.loop.run_until_complete(server.stop())
+
+        self.thread = threading.Thread(target=run, daemon=True)
+        self.thread.start()
+        assert self.ready.wait(5)
+        return self
+
+    def __exit__(self, *exc):
+        def _stop():
+            for task in asyncio.all_tasks(self.loop):
+                task.cancel()
+            self.loop.call_later(0.05, self.loop.stop)
+
+        self.loop.call_soon_threadsafe(_stop)
+        self.thread.join(5)
+        self.loop.close()
+
+
+def _live_runner_patch(runner):
+    return patch("gateway.run._gateway_runner_ref", return_value=runner)
+
+
+# --- the control verb, over the real socket --------------------------------------------------
+
+def test_forward_delivers_through_gateway_adapter(home):
+    adapter = FakeAdapter()
+    with GatewayHarness(home, adapter):
+        result = fwd.forward_matrix_send(home, ROOM, "hello", [], THREAD)
+    assert result == {"success": True, "platform": "matrix", "chat_id": ROOM, "message_id": "$sent:example.com"}
+    assert adapter.calls == [("send", ROOM, "hello", {"thread_id": THREAD})]
+
+
+def test_forward_media_arrives_as_path_voice_pairs(home, tmp_path):
+    img = tmp_path / "a.png"
+    img.write_bytes(b"x")
+    adapter = FakeAdapter()
+    with GatewayHarness(home, adapter):
+        result = fwd.forward_matrix_send(home, ROOM, "cap", [(str(img), False)], None)
+    assert result["success"] is True and result["message_id"] == "$img:example.com"
+    assert [c[0] for c in adapter.calls] == ["send", "send_image_file"]
+    assert adapter.calls[0][3] is None
+
+
+def test_forward_returns_adapter_failure_as_error_result(home):
+    with GatewayHarness(home, FakeAdapter(fail="M_FORBIDDEN")):
+        result = fwd.forward_matrix_send(home, ROOM, "hello", [], None)
+    assert result == {"error": "Matrix send failed: M_FORBIDDEN"}
+
+
+def test_forward_reports_gateway_without_matrix_adapter(home):
+    with GatewayHarness(home, None):
+        result = fwd.forward_matrix_send(home, ROOM, "hello", [], None)
+    assert "Matrix adapter" in result["error"] and "not connected" in result["error"]
+
+
+def test_forward_unconnected_gateway_never_reaches_adapter_for_bad_params(home):
+    adapter = FakeAdapter()
+    with GatewayHarness(home, adapter):
+        result = fwd._exchange(home, {"chat_id": 5, "message": "x"}, 5.0)
+    assert "invalid" in result["error"].lower()
+    assert adapter.calls == []
+
+
+# --- gateway state -----------------------------------------------------------------------------
+
+def test_no_gateway_means_standalone(home):
+    assert fwd.forward_matrix_send(home, ROOM, "hello", [], None) is None
+
+
+def test_stale_socket_with_no_owner_means_standalone(home):
+    import socket as _s
+    path = home / "gateway.sock"
+    s = _s.socket(_s.AF_UNIX)
+    s.bind(str(path))
+    s.close()  # a socket file nobody listens on: a crashed gateway's leftover
+    assert fwd.forward_matrix_send(home, ROOM, "hello", [], None) is None
+
+
+@pytest.mark.parametrize("state", ["starting", "inaccessible"])
+def test_running_gateway_that_does_not_answer_is_a_refusal(home, state):
+    with patch.object(fwd, "missing_owner_state", return_value=state):
+        result = fwd.forward_matrix_send(home, ROOM, "hello", [], None)
+    assert result is not None and "error" in result
+    assert "gateway" in result["error"] and "second Matrix connection" in result["error"]
+
+
+def test_gateway_timeout_says_it_may_have_been_delivered(home):
+    class Slow(FakeAdapter):
+        async def send(self, *a, **k):
+            await asyncio.sleep(2)
+            return await super().send(*a, **k)
+
+    with GatewayHarness(home, Slow()):
+        result = fwd.forward_matrix_send(home, ROOM, "hello", [], None, timeout=0.3)
+    assert "may have been delivered" in result["error"]
+
+
+# --- the sender: hand off, refuse, or (no gateway) stay standalone ------------------------------
+
+def _pconfig():
+    return SimpleNamespace(enabled=True, token="tok", extra={})
+
+
+def _no_own_connection():
+    """Any construction of a Matrix adapter in the sending process is a test failure."""
+    def boom(*_a, **_k):
+        raise AssertionError("opened its own Matrix connection")
+    return patch("plugins.platforms.matrix.adapter.MatrixAdapter.__init__", boom)
+
+
+def test_sender_hands_message_to_running_gateway(home):
+    adapter = FakeAdapter()
+    with GatewayHarness(home, adapter), _live_runner_patch(None), \
+            _no_own_connection():
+        result = asyncio.run(_send_matrix_via_adapter(_pconfig(), ROOM, "hi", thread_id=THREAD))
+    assert result["success"] is True and result["message_id"] == "$sent:example.com"
+    assert adapter.calls == [("send", ROOM, "hi", {"thread_id": THREAD})]
+
+
+def test_sender_refuses_when_gateway_up_but_unreachable(home):
+    with patch.object(fwd, "missing_owner_state", return_value="starting"), _live_runner_patch(None), \
+            _no_own_connection():
+        result = asyncio.run(_send_matrix_via_adapter(_pconfig(), ROOM, "hi"))
+    assert "error" in result and "second Matrix connection" in result["error"]
+
+
+def test_sender_inside_the_gateway_process_never_forwards_to_itself(home):
+    """Live-adapter lookup failure inside the gateway keeps today's behaviour (no self-forward)."""
+    runner = SimpleNamespace(adapters={}, _authorization_adapter=lambda *_a: None)
+    forward = AsyncMock()
+    connected = []
+
+    class Eph:
+        def __init__(self, _c):
+            pass
+
+        async def connect(self):
+            connected.append(1)
+            return True
+
+        async def send(self, chat_id, message, metadata=None):
+            return SimpleNamespace(success=True, message_id="$e")
+
+        async def disconnect(self):
+            pass
+
+    with _live_runner_patch(runner), patch.object(fwd, "forward_matrix_send", forward), \
+            patch.dict(sys.modules, {"plugins.platforms.matrix.adapter": SimpleNamespace(MatrixAdapter=Eph)}):
+        result = asyncio.run(_send_matrix_via_adapter(_pconfig(), ROOM, "hi"))
+    assert result["success"] is True and connected == [1]
+    forward.assert_not_called()
+
+
+def test_sender_without_gateway_still_uses_ephemeral_connect(home):
+    calls = []
+
+    class Eph:
+        def __init__(self, _c):
+            pass
+
+        async def connect(self):
+            calls.append("connect")
+            return True
+
+        async def send(self, chat_id, message, metadata=None):
+            calls.append(("send", metadata))
+            return SimpleNamespace(success=True, message_id="$e")
+
+        async def disconnect(self):
+            calls.append("disconnect")
+
+    with _live_runner_patch(None), \
+            patch.dict(sys.modules, {"plugins.platforms.matrix.adapter": SimpleNamespace(MatrixAdapter=Eph)}):
+        result = asyncio.run(_send_matrix_via_adapter(_pconfig(), ROOM, "hi", thread_id=THREAD))
+    assert result["success"] is True
+    assert calls == ["connect", ("send", {"thread_id": THREAD}), "disconnect"]
+
+
+# --- end to end: `hermes send --json` result and thread target shape ----------------------------
+
+def _matrix_config():
+    from gateway.config import GatewayConfig, PlatformConfig
+    return GatewayConfig(platforms={Platform.MATRIX: PlatformConfig(enabled=True, token="tok")})
+
+
+def _hermes_send_json(target, text):
+    from hermes_cli.send_cmd import cmd_send
+    import argparse
+    import io
+    ns = argparse.Namespace(to=target, message=None, file="-", subject=None, mentions=None,
+                            list_targets=False, quiet=False, json=True)
+    out, code = io.StringIO(), None
+    with patch("sys.stdin", io.StringIO(text)), patch("sys.stdout", out), \
+            patch("hermes_cli.send_cmd._load_hermes_env"), \
+            patch("gateway.config.load_gateway_config", return_value=_matrix_config()):
+        try:
+            cmd_send(ns)
+        except SystemExit as exc:
+            code = exc.code
+    return code, json.loads(out.getvalue())
+
+
+def test_hermes_send_json_result_and_thread_target_match_live_adapter_output(home):
+    adapter = FakeAdapter()
+    with GatewayHarness(home, adapter), _live_runner_patch(None), \
+            _no_own_connection():
+        code, payload = _hermes_send_json(f"matrix:{ROOM}:{THREAD}", "notice body\n")
+    assert code == 0
+    assert payload == {"success": True, "platform": "matrix", "chat_id": ROOM, "message_id": "$sent:example.com"}
+    assert adapter.calls == [("send", ROOM, "notice body\n", {"thread_id": THREAD})]
+
+
+def test_hermes_send_exits_1_with_json_error_when_gateway_unreachable(home):
+    with patch.object(fwd, "missing_owner_state", return_value="starting"), _live_runner_patch(None), \
+            _no_own_connection():
+        code, payload = _hermes_send_json(f"matrix:{ROOM}", "notice body\n")
+    assert code == 1
+    assert "second Matrix connection" in payload["error"]
